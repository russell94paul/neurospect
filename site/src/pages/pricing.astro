---
import Base from "../layouts/Base.astro";
import WaitlistForm from "../components/WaitlistForm.astro";

const tiers = [
  {
    name: "Free",
    price: "0",
    period: "forever",
    target: "Curious learners",
    cta: "Get Started",
    highlight: false,
    neon: "",
    features: [
      "5 AI coaching questions/day",
      "Read-only ICT glossary",
      "Basic trade journal",
      "Community access",
    ],
  },
  {
    name: "Mentor",
    price: "29",
    period: "/month",
    target: "Active ICT students",
    cta: "Join Waitlist",
    highlight: false,
    neon: "neon-card-cyan",
    features: [
      "Unlimited AI coaching",
      "Full trade journal",
      "Basic analytics",
      "Conversation history",
      "Voice journaling",
      "Psychology profiler",
      "Entry model checklists",
    ],
  },
  {
    name: "Trader",
    price: "99",
    period: "/month",
    target: "Serious traders",
    cta: "Join Waitlist",
    highlight: true,
    neon: "neon-card-cyan",
    features: [
      "Everything in Mentor",
      "Backtesting (3 runs/month)",
      "Basic Monte Carlo simulation",
      "Strategy performance reports",
      "Economic calendar integration",
      "Broker auto-fill (Tradovate)",
      "Risk limit engine",
      "Prop firm rule presets",
    ],
  },
  {
    name: "Research",
    price: "199",
    period: "/month",
    target: "Strategy researchers",
    cta: "Join Waitlist",
    highlight: false,
    neon: "neon-card-purple",
    features: [
      "Everything in Trader",
      "Unlimited backtesting",
      "Walk-forward optimization",
      "Full Monte Carlo analysis",
      "EdgeLab experiments",
      "Feature library access",
      "NSLM prompt comparison",
      "Replay review",
    ],
  },
  {
    name: "Quant",
    price: "349",
    period: "/month",
    target: "Quant-curious traders",
    cta: "Join Waitlist",
    highlight: false,
    neon: "neon-card-emerald",
    features: [
      "Everything in Research",
      "Hybrid model building",
      "Feature engineering",
      "Regime detection",
      "Model training & evaluation",
      "NeuroQuant access",
      "NeuroTrader shadow mode",
    ],
  },
  {
    name: "Team",
    price: "499",
    period: "/month",
    target: "Educators & teams",
    cta: "Contact Us",
    highlight: false,
    neon: "neon-card-amber",
    features: [
      "Everything in Quant",
      "Private knowledge bases",
      "Custom NSLM variants",
      "Paper & live trading",
      "API access",
      "Multi-user management",
      "Revenue share program",
    ],
  },
];
---

<Base title="Pricing — NeuroSpect" description="Plans for every stage of your ICT trading journey. From free learner to full quant.">
  <section class="py-24 sm:py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/20 via-black to-black"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-brand-500/[0.04] rounded-full blur-[120px]"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16 animate-on-scroll">
        <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Pricing</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
          Grow Into Your Edge
        </h1>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto">
          Start free. Upgrade as your trading evolves. Every tier unlocks more of the platform.
        </p>
      </div>

      <!-- Tier cards -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 stagger-children mb-16">
        {tiers.map((tier) => (
          <div class={`animate-on-scroll relative rounded-2xl neon-card ${tier.neon} p-6 ${
            tier.highlight ? "ring-1 ring-brand-500/30" : ""
          }`}>
            {tier.highlight && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-black bg-brand-400 px-3 py-1 rounded-full shadow-lg shadow-brand-500/30">Most Popular</span>
              </div>
            )}

            <div class="mb-5">
              <h3 class="text-lg font-bold text-white mb-1">{tier.name}</h3>
              <p class="text-xs text-slate-500">{tier.target}</p>
            </div>

            <div class="flex items-baseline gap-1 mb-6">
              <span class="text-4xl font-extrabold text-white">${tier.price}</span>
              <span class="text-sm text-slate-500">{tier.period}</span>
            </div>

            <a
              href="#waitlist"
              class={`block w-full text-center py-2.5 rounded-xl text-sm font-semibold transition-all mb-6 ${
                tier.highlight
                  ? "bg-brand-500 hover:bg-brand-400 text-white hover:shadow-lg hover:shadow-brand-500/25"
                  : "bg-white/[0.06] hover:bg-white/[0.1] text-slate-300 hover:text-white border border-white/[0.06]"
              }`}
            >
              {tier.cta}
            </a>

            <ul class="space-y-2.5">
              {tier.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm text-slate-400">
                  <svg class={`w-4 h-4 flex-shrink-0 mt-0.5 ${tier.highlight ? "text-brand-400" : "text-slate-600"}`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Educator CTA -->
      <div class="animate-on-scroll max-w-3xl mx-auto rounded-2xl neon-card neon-card-amber p-8 text-center">
        <h3 class="text-xl font-bold text-white mb-3">For ICT Educators & Mentors</h3>
        <p class="text-slate-400 mb-6 max-w-xl mx-auto">
          Turn your content into an AI coach. Your students get 24/7 personalized coaching grounded in YOUR methodology. First instructor onboards free as a design partner.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <div class="text-sm text-slate-500">
            <span class="text-white font-semibold">$199/mo</span> + 15-25% revenue share
          </div>
          <a href="#waitlist" class="px-6 py-2.5 rounded-xl border border-brand-500/30 text-brand-400 hover:bg-brand-500/10 text-sm font-medium transition-all">
            Partner With Us
          </a>
        </div>
      </div>

      <!-- Comparison callout -->
      <div class="animate-on-scroll mt-16 text-center">
        <p class="text-slate-600 text-sm max-w-2xl mx-auto">
          All paid tiers include unlimited AI coaching, full trade journal, and access to the ICT knowledge base.
          <br/>
          Prices shown are launch pricing &mdash; early waitlist members lock in these rates.
        </p>
      </div>
    </div>
  </section>

  <WaitlistForm />
</Base>
