---
import Base from "../../layouts/Base.astro";
import ProfileForm from "../../components/course/ProfileForm.astro";
import PersonalizedPath from "../../components/course/PersonalizedPath.astro";
---

<Base title="NeuroSpect — Your Trading Profile" description="Tell us about your trading experience. We'll build a personalized ICT learning path in 60 seconds.">
  <!-- Compact hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/30 via-black to-black"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-brand-500/[0.06] rounded-full blur-[120px]"></div>

    <div class="relative max-w-2xl mx-auto px-4 sm:px-6 pt-28 pb-12 sm:pt-36 sm:pb-16 text-center">
      <div class="animate-on-scroll inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/[0.08] bg-white/[0.03] text-xs text-slate-400 mb-6 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5 text-brand-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10" stroke-linecap="round"/></svg>
        Takes 60 seconds
      </div>

      <h1 class="animate-on-scroll text-3xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Tell Us About Your Trading
      </h1>

      <p class="animate-on-scroll text-base sm:text-lg text-slate-500 max-w-xl mx-auto leading-relaxed">
        We'll build a learning path customized to your experience and goals.
      </p>
    </div>
  </section>

  <!-- Form section -->
  <section class="relative pb-24 sm:pb-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <ProfileForm />
      <PersonalizedPath />
    </div>
  </section>
</Base>
