---
import Base from "../layouts/Base.astro";
import WaitlistForm from "../components/WaitlistForm.astro";

const components = [
  { id: "mentor", name: "NeuroSpect Mentor", sub: "AI Coaching Product", color: "#06b6d4", neon: "neon-card-cyan", desc: "Consumer-facing AI coaching. RAG + ICT knowledge + trade journal + personalized coaching with source-grounded citations." },
  { id: "neurocore", name: "NeuroCore", sub: "Knowledge Layer", color: "#8b5cf6", neon: "neon-card-purple", desc: "Hybrid 3-signal search: keyword + semantic + entity. Powers coaching RAG, cross-wiki intelligence, and agent reasoning." },
  { id: "nslm", name: "NSLM", sub: "Language Model", color: "#f59e0b", neon: "neon-card-amber", desc: "ICT-aware LLM family. Trained on private mentorship content, structured playbooks, and evaluation feedback." },
  { id: "edgelab", name: "EdgeLab", sub: "Research Engine", color: "#10b981", neon: "neon-card-emerald", desc: "Event-driven backtesting, quant feature engineering, NSLM prompt experiments, and hybrid model evaluation." },
  { id: "neuroquant", name: "NeuroQuant", sub: "Production Models", color: "#ec4899", neon: "neon-card-rose", desc: "Consumes validated features and models from EdgeLab. Regime-aware scoring, model ensembles, confluence decisions." },
  { id: "agent", name: "NeuroTrader", sub: "Trading Agent", color: "#ef4444", neon: "neon-card-red", desc: "Automated trading agent. Shadow to Paper to Live progression. 5-layer safety architecture. Gated by EdgeLab evidence." },
];
---

<Base title="Architecture — NeuroSpect" description="See how NeuroSpect's six core components work together to power AI-native ICT trading.">
  <section class="py-24 sm:py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/20 via-black to-black"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-brand-500/[0.04] rounded-full blur-[120px]"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16 animate-on-scroll">
        <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Architecture</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">Six Components. One Platform.</h1>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto">
          Every component is purpose-built for ICT trading. They connect, feed each other, and compound your edge over time.
        </p>
      </div>

      <!-- Interactive SVG Diagram -->
      <div class="animate-on-scroll mb-16">
        <div class="max-w-2xl mx-auto">
          <svg viewBox="0 0 660 600" class="w-full" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- Glow filters per color -->
              <filter id="glow-cyan" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="8" result="blur"/>
                <feFlood flood-color="#06b6d4" flood-opacity="0.3" result="color"/>
                <feComposite in="color" in2="blur" operator="in" result="glow"/>
                <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="glow-purple" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="8" result="blur"/>
                <feFlood flood-color="#8b5cf6" flood-opacity="0.3" result="color"/>
                <feComposite in="color" in2="blur" operator="in" result="glow"/>
                <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="glow-amber" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="8" result="blur"/>
                <feFlood flood-color="#f59e0b" flood-opacity="0.3" result="color"/>
                <feComposite in="color" in2="blur" operator="in" result="glow"/>
                <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="glow-emerald" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="8" result="blur"/>
                <feFlood flood-color="#10b981" flood-opacity="0.3" result="color"/>
                <feComposite in="color" in2="blur" operator="in" result="glow"/>
                <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="glow-rose" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="8" result="blur"/>
                <feFlood flood-color="#ec4899" flood-opacity="0.3" result="color"/>
                <feComposite in="color" in2="blur" operator="in" result="glow"/>
                <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="glow-red" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="8" result="blur"/>
                <feFlood flood-color="#ef4444" flood-opacity="0.3" result="color"/>
                <feComposite in="color" in2="blur" operator="in" result="glow"/>
                <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>

              <!-- Connection line glow -->
              <filter id="line-glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="4" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>

              <!-- Grid pattern -->
              <pattern id="grid" width="30" height="30" patternUnits="userSpaceOnUse">
                <path d="M 30 0 L 0 0 0 30" fill="none" stroke="rgba(255,255,255,0.025)" stroke-width="0.5"/>
              </pattern>
            </defs>

            <rect width="660" height="600" fill="transparent"/>
            <rect width="660" height="600" fill="url(#grid)"/>

            <!-- Layer dividers -->
            <line x1="40" y1="135" x2="620" y2="135" stroke="rgba(255,255,255,0.03)" stroke-width="1" stroke-dasharray="4 8"/>
            <line x1="40" y1="295" x2="620" y2="295" stroke="rgba(255,255,255,0.03)" stroke-width="1" stroke-dasharray="4 8"/>
            <line x1="40" y1="455" x2="620" y2="455" stroke="rgba(255,255,255,0.03)" stroke-width="1" stroke-dasharray="4 8"/>

            <!-- Layer labels -->
            <text x="635" y="80" fill="rgba(255,255,255,0.1)" font-size="10" font-family="JetBrains Mono, monospace" text-anchor="end">CONSUMER</text>
            <text x="635" y="220" fill="rgba(255,255,255,0.1)" font-size="10" font-family="JetBrains Mono, monospace" text-anchor="end">INTELLIGENCE</text>
            <text x="635" y="380" fill="rgba(255,255,255,0.1)" font-size="10" font-family="JetBrains Mono, monospace" text-anchor="end">RESEARCH</text>
            <text x="635" y="530" fill="rgba(255,255,255,0.1)" font-size="10" font-family="JetBrains Mono, monospace" text-anchor="end">AUTOMATION</text>

            <!-- ===== ANIMATED CONNECTIONS ===== -->

            <!-- NeuroCore → Mentor (retrieval) -->
            <g filter="url(#line-glow)">
              <path d="M 195 195 C 195 140, 290 110, 290 85" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-opacity="0.15"/>
              <path d="M 195 195 C 195 140, 290 110, 290 85" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.5">
                <animate attributeName="stroke-dashoffset" values="0;-24" dur="2s" repeatCount="indefinite"/>
                <animate attributeName="stroke-opacity" values="0.3;0.7;0.3" dur="3s" repeatCount="indefinite"/>
              </path>
              <!-- Moving particle -->
              <circle r="3" fill="#8b5cf6" opacity="0.9">
                <animateMotion dur="2.5s" repeatCount="indefinite" path="M 195 195 C 195 140, 290 110, 290 85"/>
              </circle>
            </g>
            <text x="225" y="135" fill="#8b5cf6" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.6">retrieval</text>

            <!-- NSLM → Mentor (generation) -->
            <g filter="url(#line-glow)">
              <path d="M 465 195 C 465 140, 370 110, 370 85" fill="none" stroke="#f59e0b" stroke-width="2" stroke-opacity="0.15"/>
              <path d="M 465 195 C 465 140, 370 110, 370 85" fill="none" stroke="#f59e0b" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.5">
                <animate attributeName="stroke-dashoffset" values="0;-24" dur="2.2s" repeatCount="indefinite"/>
                <animate attributeName="stroke-opacity" values="0.3;0.7;0.3" dur="3.5s" repeatCount="indefinite"/>
              </path>
              <circle r="3" fill="#f59e0b" opacity="0.9">
                <animateMotion dur="2.8s" repeatCount="indefinite" path="M 465 195 C 465 140, 370 110, 370 85"/>
              </circle>
            </g>
            <text x="430" y="135" fill="#f59e0b" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.6">generation</text>

            <!-- NeuroCore → EdgeLab (data) -->
            <g filter="url(#line-glow)">
              <path d="M 195 240 L 195 340" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-opacity="0.15"/>
              <path d="M 195 240 L 195 340" fill="none" stroke="#10b981" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.5">
                <animate attributeName="stroke-dashoffset" values="0;-24" dur="1.8s" repeatCount="indefinite"/>
                <animate attributeName="stroke-opacity" values="0.3;0.6;0.3" dur="2.5s" repeatCount="indefinite"/>
              </path>
              <circle r="3" fill="#10b981" opacity="0.9">
                <animateMotion dur="2s" repeatCount="indefinite" path="M 195 240 L 195 340"/>
              </circle>
            </g>
            <text x="205" y="295" fill="#10b981" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.6">data</text>

            <!-- EdgeLab → NSLM (evaluation) -->
            <g filter="url(#line-glow)">
              <path d="M 270 360 C 340 310, 390 310, 400 240" fill="none" stroke="#10b981" stroke-width="2" stroke-opacity="0.15"/>
              <path d="M 270 360 C 340 310, 390 310, 400 240" fill="none" stroke="#10b981" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.5">
                <animate attributeName="stroke-dashoffset" values="0;-24" dur="2.4s" repeatCount="indefinite"/>
                <animate attributeName="stroke-opacity" values="0.3;0.6;0.3" dur="3s" repeatCount="indefinite"/>
              </path>
              <circle r="3" fill="#f59e0b" opacity="0.9">
                <animateMotion dur="3s" repeatCount="indefinite" path="M 270 360 C 340 310, 390 310, 400 240"/>
              </circle>
            </g>
            <text x="345" y="300" fill="#10b981" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.6">evaluation</text>

            <!-- EdgeLab → NeuroQuant (promotion) -->
            <g filter="url(#line-glow)">
              <path d="M 270 380 L 390 380" fill="none" stroke="#10b981" stroke-width="2" stroke-opacity="0.15"/>
              <path d="M 270 380 L 390 380" fill="none" stroke="#ec4899" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.5">
                <animate attributeName="stroke-dashoffset" values="0;-24" dur="1.6s" repeatCount="indefinite"/>
                <animate attributeName="stroke-opacity" values="0.3;0.7;0.3" dur="2.8s" repeatCount="indefinite"/>
              </path>
              <circle r="3" fill="#ec4899" opacity="0.9">
                <animateMotion dur="2s" repeatCount="indefinite" path="M 270 380 L 390 380"/>
              </circle>
            </g>
            <text x="320" y="370" fill="#ec4899" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.6" text-anchor="middle">promotion</text>

            <!-- NeuroQuant → Agent (scoring) -->
            <g filter="url(#line-glow)">
              <path d="M 465 420 C 465 470, 370 470, 370 490" fill="none" stroke="#ec4899" stroke-width="2" stroke-opacity="0.15"/>
              <path d="M 465 420 C 465 470, 370 470, 370 490" fill="none" stroke="#ef4444" stroke-width="2" stroke-dasharray="6 6" stroke-opacity="0.5">
                <animate attributeName="stroke-dashoffset" values="0;-24" dur="2s" repeatCount="indefinite"/>
                <animate attributeName="stroke-opacity" values="0.3;0.7;0.3" dur="3.2s" repeatCount="indefinite"/>
              </path>
              <circle r="3" fill="#ef4444" opacity="0.9">
                <animateMotion dur="2.5s" repeatCount="indefinite" path="M 465 420 C 465 470, 370 470, 370 490"/>
              </circle>
            </g>
            <text x="435" y="465" fill="#ef4444" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.6">scoring</text>

            <!-- ===== COMPONENT NODES ===== -->

            <!-- Mentor (top center) -->
            <g>
              <rect x="250" y="40" width="160" height="55" rx="14" fill="rgba(25,25,30,0.9)" stroke="#06b6d4" stroke-width="1.5" filter="url(#glow-cyan)"/>
              <circle cx="272" cy="67" r="5" fill="#06b6d4" opacity="0.9">
                <animate attributeName="opacity" values="0.5;1;0.5" dur="3s" repeatCount="indefinite"/>
                <animate attributeName="r" values="4;5.5;4" dur="3s" repeatCount="indefinite"/>
              </circle>
              <text x="330" y="62" text-anchor="middle" fill="white" font-size="13" font-weight="700" font-family="Inter, sans-serif">NeuroSpect Mentor</text>
              <text x="330" y="78" text-anchor="middle" fill="#06b6d4" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.8">AI Coaching Product</text>
            </g>

            <!-- NeuroCore (left middle) -->
            <g>
              <rect x="100" y="190" width="160" height="55" rx="14" fill="rgba(25,25,30,0.9)" stroke="#8b5cf6" stroke-width="1.5" filter="url(#glow-purple)"/>
              <circle cx="122" cy="217" r="5" fill="#8b5cf6" opacity="0.9">
                <animate attributeName="opacity" values="0.5;1;0.5" dur="2.8s" begin="0.5s" repeatCount="indefinite"/>
                <animate attributeName="r" values="4;5.5;4" dur="2.8s" begin="0.5s" repeatCount="indefinite"/>
              </circle>
              <text x="190" y="212" text-anchor="middle" fill="white" font-size="13" font-weight="700" font-family="Inter, sans-serif">NeuroCore</text>
              <text x="190" y="228" text-anchor="middle" fill="#8b5cf6" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.8">Knowledge Layer</text>
            </g>

            <!-- NSLM (right middle) -->
            <g>
              <rect x="400" y="190" width="160" height="55" rx="14" fill="rgba(25,25,30,0.9)" stroke="#f59e0b" stroke-width="1.5" filter="url(#glow-amber)"/>
              <circle cx="422" cy="217" r="5" fill="#f59e0b" opacity="0.9">
                <animate attributeName="opacity" values="0.5;1;0.5" dur="3.2s" begin="1s" repeatCount="indefinite"/>
                <animate attributeName="r" values="4;5.5;4" dur="3.2s" begin="1s" repeatCount="indefinite"/>
              </circle>
              <text x="490" y="212" text-anchor="middle" fill="white" font-size="13" font-weight="700" font-family="Inter, sans-serif">NSLM</text>
              <text x="490" y="228" text-anchor="middle" fill="#f59e0b" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.8">Language Model</text>
            </g>

            <!-- EdgeLab (left lower) -->
            <g>
              <rect x="100" y="340" width="160" height="55" rx="14" fill="rgba(25,25,30,0.9)" stroke="#10b981" stroke-width="1.5" filter="url(#glow-emerald)"/>
              <circle cx="122" cy="367" r="5" fill="#10b981" opacity="0.9">
                <animate attributeName="opacity" values="0.5;1;0.5" dur="2.5s" begin="1.5s" repeatCount="indefinite"/>
                <animate attributeName="r" values="4;5.5;4" dur="2.5s" begin="1.5s" repeatCount="indefinite"/>
              </circle>
              <text x="190" y="362" text-anchor="middle" fill="white" font-size="13" font-weight="700" font-family="Inter, sans-serif">EdgeLab</text>
              <text x="190" y="378" text-anchor="middle" fill="#10b981" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.8">Research Engine</text>
            </g>

            <!-- NeuroQuant (right lower) -->
            <g>
              <rect x="400" y="340" width="160" height="55" rx="14" fill="rgba(25,25,30,0.9)" stroke="#ec4899" stroke-width="1.5" filter="url(#glow-rose)"/>
              <circle cx="422" cy="367" r="5" fill="#ec4899" opacity="0.9">
                <animate attributeName="opacity" values="0.5;1;0.5" dur="3s" begin="2s" repeatCount="indefinite"/>
                <animate attributeName="r" values="4;5.5;4" dur="3s" begin="2s" repeatCount="indefinite"/>
              </circle>
              <text x="490" y="362" text-anchor="middle" fill="white" font-size="13" font-weight="700" font-family="Inter, sans-serif">NeuroQuant</text>
              <text x="490" y="378" text-anchor="middle" fill="#ec4899" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.8">Production Models</text>
            </g>

            <!-- NeuroTrader (bottom center) -->
            <g>
              <rect x="250" y="490" width="160" height="55" rx="14" fill="rgba(25,25,30,0.9)" stroke="#ef4444" stroke-width="1.5" filter="url(#glow-red)"/>
              <circle cx="272" cy="517" r="5" fill="#ef4444" opacity="0.9">
                <animate attributeName="opacity" values="0.5;1;0.5" dur="2.6s" begin="2.5s" repeatCount="indefinite"/>
                <animate attributeName="r" values="4;5.5;4" dur="2.6s" begin="2.5s" repeatCount="indefinite"/>
              </circle>
              <text x="340" y="512" text-anchor="middle" fill="white" font-size="13" font-weight="700" font-family="Inter, sans-serif">NeuroTrader</text>
              <text x="340" y="528" text-anchor="middle" fill="#ef4444" font-size="9" font-family="JetBrains Mono, monospace" opacity="0.8">Trading Agent</text>
            </g>
          </svg>
        </div>
      </div>

      <!-- Component detail cards -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 stagger-children">
        {components.map((comp) => (
          <div class={`animate-on-scroll group rounded-2xl neon-card ${comp.neon} p-5`}>
            <div class="flex items-center gap-3 mb-3">
              <div class="relative w-3 h-3 rounded-full" style={`background: ${comp.color}; box-shadow: 0 0 10px ${comp.color}60;`}>
              </div>
              <h3 class="text-sm font-semibold text-white">{comp.name}</h3>
              <span class="text-[10px] font-mono text-slate-600">{comp.sub}</span>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed">{comp.desc}</p>
          </div>
        ))}
      </div>

      <!-- Data flow explanation -->
      <div class="animate-on-scroll mt-16 rounded-2xl neon-card p-6 sm:p-8">
        <h3 class="text-lg font-bold text-white mb-6">How Data Flows Through NeuroSpect</h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="relative">
            <div class="text-3xl font-bold text-brand-500/20 mb-2">01</div>
            <h4 class="text-sm font-semibold text-white mb-1">Ingest</h4>
            <p class="text-xs text-slate-500">ICT mentorship content, transcripts, and your trade journal flow into NeuroCore's hybrid index.</p>
          </div>
          <div class="relative">
            <div class="text-3xl font-bold text-brand-500/20 mb-2">02</div>
            <h4 class="text-sm font-semibold text-white mb-1">Retrieve & Reason</h4>
            <p class="text-xs text-slate-500">NeuroCore retrieves relevant context. NSLM generates ICT-aware responses with source citations.</p>
          </div>
          <div class="relative">
            <div class="text-3xl font-bold text-brand-500/20 mb-2">03</div>
            <h4 class="text-sm font-semibold text-white mb-1">Research & Validate</h4>
            <p class="text-xs text-slate-500">EdgeLab backtests strategies, evaluates NSLM versions, and promotes validated models to NeuroQuant.</p>
          </div>
          <div class="relative">
            <div class="text-3xl font-bold text-brand-500/20 mb-2">04</div>
            <h4 class="text-sm font-semibold text-white mb-1">Execute</h4>
            <p class="text-xs text-slate-500">NeuroTrader Agent uses NeuroQuant scoring to trade &mdash; with 5 safety layers and full human oversight.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WaitlistForm />
</Base>
