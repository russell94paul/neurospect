---

---

<section id="waitlist" class="py-24 sm:py-32 relative">
  <div class="absolute inset-0 bg-gradient-to-b from-black via-brand-950/20 to-black"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-brand-500/[0.05] rounded-full blur-[100px]"></div>

  <div class="relative max-w-xl mx-auto px-4 sm:px-6 text-center">
    <div class="animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Early Access</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Be the first to trade with an AI that thinks in ICT.
      </h2>
      <p class="text-slate-500 text-lg mb-10">
        Early access. Limited spots. No credit card required.
      </p>
    </div>

    <form id="waitlist-form" class="animate-on-scroll flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
      <input
        type="email"
        name="email"
        required
        placeholder="you@example.com"
        class="flex-1 px-4 py-3.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white placeholder:text-slate-600 focus:outline-none focus:border-brand-500/50 focus:ring-1 focus:ring-brand-500/30 focus:bg-white/[0.06] text-sm transition-all"
      />
      <button
        type="submit"
        class="px-6 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-white font-semibold text-sm transition-all whitespace-nowrap hover:shadow-lg hover:shadow-brand-500/25 hover:-translate-y-0.5 active:translate-y-0"
      >
        Join Waitlist
      </button>
    </form>

    <div id="waitlist-success" class="hidden mt-6 animate-on-scroll visible">
      <div class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-brand-500/20 bg-brand-500/10 text-sm text-brand-300">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        You're on the list. We'll be in touch.
      </div>
    </div>

    <p class="animate-on-scroll text-xs text-slate-700 mt-5">We respect your privacy. No spam, ever.</p>
  </div>
</section>

<script>
  const form = document.getElementById("waitlist-form") as HTMLFormElement;
  const success = document.getElementById("waitlist-success") as HTMLDivElement;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    form.classList.add("hidden");
    success.classList.remove("hidden");
  });
</script>
