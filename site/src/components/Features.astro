            <span class={`text-[11px] font-medium px-2.5 py-1 rounded-full ${f.badgeColor}`}>{f.badge}</span>
          </div>
          <h3 class="text-sm font-semibold text-white mb-2 group-hover:text-brand-300 transition-colors">{f.title}</h3>
