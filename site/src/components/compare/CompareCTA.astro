<section class="py-24 sm:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-black via-brand-950/20 to-black"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-brand-500/[0.06] rounded-full blur-[100px]"></div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <div class="animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">See the Proof</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Numbers Don't Lie. Neither Do We.
      </h2>
      <p class="text-slate-500 text-lg max-w-xl mx-auto mb-10">
        See how NeuroSpect's integrated approach translates to measurable improvements in the Performance Lab, or join the waitlist to experience it firsthand.
      </p>
    </div>

    <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
      <a
        href="/performance"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-white font-semibold text-base transition-all hover:shadow-lg hover:shadow-brand-500/25 hover:-translate-y-0.5 active:translate-y-0"
      >
        See Performance Lab
      </a>
      <a
        href="#waitlist"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl border border-white/[0.08] hover:border-white/[0.15] bg-white/[0.02] hover:bg-white/[0.04] text-slate-300 hover:text-white font-medium text-base transition-all"
      >
        Join Waitlist
      </a>
    </div>

    <p class="animate-on-scroll text-xs text-slate-600">
      All performance claims are illustrative and based on simulated scenarios. Not financial advice.
    </p>
  </div>
</section>
