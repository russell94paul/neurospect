---
import { WORKFLOW_BEFORE, WORKFLOW_AFTER, WORKFLOW_KPIS } from "../../data/competitors";
---

<section class="py-24 sm:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-black via-slate-950/50 to-black"></div>
  <div class="absolute bottom-1/4 left-1/3 w-[500px] h-[500px] bg-brand-500/[0.03] rounded-full blur-[120px]"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16 animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Workflow Friction</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">From Fragmented to Integrated</h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto">
        Every context switch is a leak in your process. See how NeuroSpect streamlines the typical ICT trading workflow.
      </p>
    </div>

    <!-- Before/After workflow chains -->
    <div class="grid lg:grid-cols-2 gap-8 mb-16">
      <!-- Before -->
      <div class="animate-on-scroll">
        <div class="flex items-center gap-2 mb-5">
          <div class="w-6 h-6 rounded bg-red-500/10 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-red-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Before</h3>
          <span class="text-xs text-slate-600 font-mono">7 tools, 7 context switches</span>
        </div>

        <div class="space-y-2">
          {WORKFLOW_BEFORE.map((step, i) => (
            <div class="flex items-center gap-3">
              <div class="flex flex-col items-center">
                <div class="w-8 h-8 rounded-lg bg-white/[0.04] border border-white/[0.06] flex items-center justify-center text-xs font-mono text-slate-500">
                  {i + 1}
                </div>
                {i < WORKFLOW_BEFORE.length - 1 && (
                  <div class="w-px h-2 bg-white/[0.06] mt-1"></div>
                )}
              </div>
              <div class="flex-1 flex items-center justify-between rounded-lg bg-white/[0.02] border border-white/[0.04] px-3 py-2.5">
                <span class="text-sm text-slate-300">{step.label}</span>
                <span class="text-[11px] font-mono text-red-400/70 bg-red-500/5 px-2 py-0.5 rounded">{step.tool}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- After -->
      <div class="animate-on-scroll">
        <div class="flex items-center gap-2 mb-5">
          <div class="w-6 h-6 rounded bg-brand-500/10 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-brand-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider">After</h3>
          <span class="text-xs text-slate-600 font-mono">1 platform, shared context</span>
        </div>

        <div class="space-y-2">
          {WORKFLOW_AFTER.map((step, i) => (
            <div class="flex items-center gap-3">
              <div class="flex flex-col items-center">
                <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-xs font-mono text-brand-400">
                  {i + 1}
                </div>
                {i < WORKFLOW_AFTER.length - 1 && (
                  <div class="w-px h-2 bg-brand-500/20 mt-1"></div>
                )}
              </div>
              <div class="flex-1 flex items-center justify-between rounded-lg bg-brand-500/[0.03] border border-brand-500/10 px-3 py-2.5">
                <span class="text-sm text-slate-300">{step.label}</span>
                <span class="text-[11px] font-mono text-brand-400/70 bg-brand-500/5 px-2 py-0.5 rounded">{step.tool}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- KPI cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3 stagger-children">
      {WORKFLOW_KPIS.map((kpi) => (
        <div class="animate-on-scroll rounded-2xl neon-card p-5 text-center">
          <div class="text-xl font-extrabold text-brand-400 mb-2 font-mono">{kpi.metric}</div>
          <p class="text-xs text-slate-500 leading-relaxed">{kpi.description}</p>
        </div>
      ))}
    </div>

    <div class="animate-on-scroll mt-6 text-center">
      <p class="text-xs text-slate-600">
        Improvements are estimated based on typical ICT trading workflows. Individual results will vary.
      </p>
    </div>
  </div>
</section>
