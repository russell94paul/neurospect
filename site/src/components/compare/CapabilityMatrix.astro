---
import { CAPABILITIES } from "../../data/competitors";

const columns = [
  { key: "chatbot" as const, label: "Generic AI Chatbot" },
  { key: "journal" as const, label: "Trade Journal" },
  { key: "backtester" as const, label: "Backtester" },
  { key: "scripts" as const, label: "TV Scripts" },
  { key: "discord" as const, label: "Signal Groups" },
  { key: "spreadsheet" as const, label: "Spreadsheet" },
  { key: "neurospect" as const, label: "NeuroSpect" },
];

function cellClass(level: string): string {
  if (level === "yes") return "matrix-cell-yes";
  if (level === "partial") return "matrix-cell-partial";
  return "matrix-cell-no";
}

function cellSymbol(level: string): string {
  if (level === "yes") return "✓";
  if (level === "partial") return "~";
  return "—";
}
---

<section id="capability-matrix" class="py-24 sm:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-black via-slate-950/50 to-black"></div>
  <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[500px] h-[500px] bg-brand-500/[0.03] rounded-full blur-[120px]"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16 animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Capability Matrix</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">14 Capabilities. One Platform Covers All.</h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto">
        See how NeuroSpect compares to the tools you're duct-taping together today.
      </p>
    </div>

    <div class="animate-on-scroll overflow-x-auto -mx-4 sm:mx-0">
      <div class="min-w-[820px] px-4 sm:px-0">
        <table class="w-full text-sm">
          <!-- Header row -->
          <thead>
            <tr>
              <th class="text-left text-xs font-medium text-slate-600 uppercase tracking-wider pb-4 pr-4 w-[200px]">Capability</th>
              {columns.map((col) => (
                <th class={`text-center text-xs font-medium uppercase tracking-wider pb-4 px-2 ${
                  col.key === "neurospect"
                    ? "text-brand-400"
                    : "text-slate-600"
                }`}>
                  <span class={col.key === "neurospect" ? "border-b-2 border-brand-500/40 pb-1" : ""}>
                    {col.label}
                  </span>
                </th>
              ))}
            </tr>
          </thead>

          <tbody>
            {CAPABILITIES.map((cap, i) => (
              <tr class={`border-t border-white/[0.04] ${i % 2 === 0 ? "bg-white/[0.01]" : ""}`}>
                <td class="py-3 pr-4 text-sm text-slate-300 font-medium">{cap.name}</td>
                {columns.map((col) => (
                  <td class="py-3 px-2 text-center">
                    <span class={`inline-flex items-center justify-center w-8 h-8 rounded-lg text-sm font-semibold ${cellClass(cap[col.key])} ${
                      col.key === "neurospect" ? "ring-1 ring-brand-500/20" : ""
                    }`}>
                      {cellSymbol(cap[col.key])}
                    </span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>

          <!-- Summary row -->
          <tfoot>
            <tr class="border-t-2 border-white/[0.08]">
              <td class="py-4 pr-4 text-sm font-semibold text-white">Total coverage</td>
              {columns.map((col) => {
                const yesCount = CAPABILITIES.filter((c) => c[col.key] === "yes").length;
                const partialCount = CAPABILITIES.filter((c) => c[col.key] === "partial").length;
                return (
                  <td class="py-4 px-2 text-center">
                    <span class={`text-sm font-bold ${
                      col.key === "neurospect" ? "text-brand-400" : "text-slate-500"
                    }`}>
                      {yesCount}/{CAPABILITIES.length}
                    </span>
                    {partialCount > 0 && (
                      <span class="block text-[10px] text-slate-600 mt-0.5">+{partialCount} partial</span>
                    )}
                  </td>
                );
              })}
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <div class="animate-on-scroll mt-8 text-center">
      <p class="text-xs text-slate-600 max-w-xl mx-auto">
        <span class="inline-flex items-center gap-1.5 mr-3"><span class="inline-block w-3 h-3 rounded matrix-cell-yes text-center text-[9px] leading-3">&check;</span> Full support</span>
        <span class="inline-flex items-center gap-1.5 mr-3"><span class="inline-block w-3 h-3 rounded matrix-cell-partial text-center text-[9px] leading-3">~</span> Partial</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 rounded matrix-cell-no text-center text-[9px] leading-3">&mdash;</span> Not supported</span>
      </p>
    </div>
  </div>
</section>
