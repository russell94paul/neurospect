---
interface Concept {
  heading: string;
  content: string;
}

interface WorkedExample {
  title: string;
  steps: string[];
  keyInsight: string;
}

interface Props {
  lessonId: string;
  title: string;
  summary: string;
  concepts: Concept[];
  rules: string[];
  workedExample: WorkedExample;
  commonMistakes: string[];
}

const { lessonId, title, summary, concepts, rules, workedExample, commonMistakes } = Astro.props;
---

<article class="lesson-content" data-lesson-id={lessonId}>
  <!-- Summary -->
  <div class="mb-10">
    <h2 class="text-2xl font-bold text-white mb-4">{title}</h2>
    <p class="text-slate-300 text-base leading-relaxed">{summary}</p>
  </div>

  <!-- Concepts -->
  <div class="mb-10 space-y-4">
    <h3 class="text-xs text-brand-400 font-medium uppercase tracking-wider mb-4">Key Concepts</h3>
    {concepts.map((concept) => (
      <div class="border-l-4 border-brand-400 bg-white/[0.02] rounded-r-xl p-5">
        <h3 class="text-lg font-semibold text-white mb-2">{concept.heading}</h3>
        <div class="text-slate-300 text-sm leading-relaxed concept-html" set:html={concept.content} />
      </div>
    ))}
  </div>

  <!-- Rules -->
  <div class="mb-10">
    <h3 class="text-xs text-brand-400 font-medium uppercase tracking-wider mb-4">Rules</h3>
    <div class="border border-brand-500/20 bg-brand-500/5 rounded-xl p-6">
      <ul class="space-y-3">
        {rules.map((rule) => (
          <li class="flex items-start gap-3 text-sm text-slate-300">
            <svg class="w-5 h-5 text-brand-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{rule}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Worked Example -->
  <div class="mb-10">
    <h3 class="text-xs text-brand-400 font-medium uppercase tracking-wider mb-4">Worked Example</h3>
    <div class="border border-white/[0.06] bg-white/[0.02] rounded-xl p-6">
      <h4 class="text-white font-semibold text-lg mb-4">{workedExample.title}</h4>
      <ol class="space-y-3 mb-6">
        {workedExample.steps.map((step, i) => (
          <li class="flex items-start gap-3 text-sm text-slate-300">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-bold flex items-center justify-center mt-0.5">
              {i + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
      <blockquote class="border-l-4 border-brand-400 pl-4 py-2">
        <p class="text-brand-400 italic text-sm">{workedExample.keyInsight}</p>
      </blockquote>
    </div>
  </div>

  <!-- Common Mistakes -->
  <div class="mb-10">
    <h3 class="text-xs text-amber-400 font-medium uppercase tracking-wider mb-4">Common Mistakes</h3>
    <div class="border border-amber-500/20 bg-amber-500/5 rounded-xl p-6">
      <ul class="space-y-3">
        {commonMistakes.map((mistake) => (
          <li class="flex items-start gap-3 text-sm text-slate-300">
            <svg class="w-5 h-5 text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            <span>{mistake}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Mark Complete Button -->
  <div class="flex justify-end">
    <button
      class="lesson-complete-btn px-6 py-3 rounded-xl font-semibold text-sm transition-all"
      data-lesson-id={lessonId}
    >
      Mark Lesson Complete
    </button>
  </div>
</article>

<style>
  .concept-html :global(strong) {
    color: white;
    font-weight: 600;
  }
</style>

<script>
  function initLessonButtons() {
    const STORAGE_KEY = 'neurospect-course-progress';

    function getProgress() {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      try { return JSON.parse(raw); } catch { return null; }
    }

    function saveProgress(progress: any) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
      window.dispatchEvent(new CustomEvent('neurospect-progress-updated'));
    }

    function ensureProgress() {
      let progress = getProgress();
      if (!progress) {
        progress = {
          profileCompleted: false,
          profile: null,
          modules: {
            'module-1': { lessonsCompleted: [], quizScore: null, chartIdScore: null, scenarioScore: null, engagementScore: null, passed: false, attempts: 0, weakAreas: [] },
            'module-2': { lessonsCompleted: [], quizScore: null, chartIdScore: null, scenarioScore: null, engagementScore: null, passed: false, attempts: 0, weakAreas: [] },
            'module-3': { lessonsCompleted: [], quizScore: null, chartIdScore: null, scenarioScore: null, engagementScore: null, passed: false, attempts: 0, weakAreas: [] },
            'module-4': { lessonsCompleted: [], quizScore: null, chartIdScore: null, scenarioScore: null, engagementScore: null, passed: false, attempts: 0, weakAreas: [] },
            'module-5': { lessonsCompleted: [], quizScore: null, chartIdScore: null, scenarioScore: null, engagementScore: null, passed: false, attempts: 0, weakAreas: [] },
          },
          entryModelsUnlocked: false,
          completedAt: null,
        };
        saveProgress(progress);
      }
      return progress;
    }

    function updateButtonState(btn: HTMLButtonElement, lessonId: string) {
      const progress = ensureProgress();
      const mod = progress.modules['module-1'];
      const completed = mod.lessonsCompleted.includes(lessonId);

      if (completed) {
        btn.classList.remove('bg-brand-500', 'hover:bg-brand-400', 'text-white');
        btn.classList.add('bg-emerald-500/10', 'border', 'border-emerald-500/30', 'text-emerald-400');
        btn.innerHTML = '<svg class="w-4 h-4 inline mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Lesson Complete';
      } else {
        btn.classList.remove('bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-400');
        btn.classList.add('bg-brand-500', 'hover:bg-brand-400', 'text-white', 'border', 'border-transparent');
        btn.textContent = 'Mark Lesson Complete ✓';
      }
    }

    document.querySelectorAll<HTMLButtonElement>('.lesson-complete-btn').forEach((btn) => {
      const lessonId = btn.dataset.lessonId!;
      updateButtonState(btn, lessonId);

      btn.addEventListener('click', () => {
        const progress = ensureProgress();
        const mod = progress.modules['module-1'];
        const idx = mod.lessonsCompleted.indexOf(lessonId);
        if (idx === -1) {
          mod.lessonsCompleted.push(lessonId);
        } else {
          mod.lessonsCompleted.splice(idx, 1);
        }
        saveProgress(progress);
        updateButtonState(btn, lessonId);
      });
    });

    // Listen for external updates
    window.addEventListener('neurospect-progress-updated', () => {
      document.querySelectorAll<HTMLButtonElement>('.lesson-complete-btn').forEach((btn) => {
        updateButtonState(btn, btn.dataset.lessonId!);
      });
    });
  }

  initLessonButtons();
</script>
