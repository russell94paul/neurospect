---

---

<div id="personalized-path" class="hidden">
  <div class="animate-on-scroll text-center mb-10">
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">Your Custom ICT Learning Path</h2>
    <p id="path-subtitle" class="text-sm text-slate-500 mb-1"></p>
    <p id="path-focus" class="text-sm text-slate-500"></p>
  </div>

  <div id="path-modules" class="space-y-4 mb-10">
    <!-- Rendered by JS -->
  </div>

  <div class="text-center">
    <a
      href="/course/module-1"
      class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-white font-semibold text-base transition-all hover:shadow-lg hover:shadow-brand-500/25 hover:-translate-y-0.5 active:translate-y-0"
    >
      Start Module 1
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    </a>
  </div>
</div>

<script>
  interface PersonalizationProfile {
    experience: string;
    ictTime: string;
    instruments: string[];
    style: string;
    struggles: string[];
    goals: string[];
  }

  interface ModuleInfo {
    id: number;
    title: string;
    description: string;
    badge: "PRIORITY" | "REVIEW" | "OPTIONAL" | "REQUIRED";
    note: string;
  }

  const modules: Array<{ id: number; title: string; description: string }> = [
    { id: 1, title: "Market Structure Foundations", description: "Swing highs/lows, BOS, CHoCH, and structural shifts across timeframes." },
    { id: 2, title: "Liquidity & Order Flow", description: "Buy-side/sell-side liquidity, stop hunts, order blocks, and institutional footprints." },
    { id: 3, title: "Daily Bias & Narrative Building", description: "HTF bias construction, weekly profiles, and building a daily trading plan." },
    { id: 4, title: "Entry Models & Execution", description: "7 ICT entry models with precise entries, stop placement, and target logic." },
    { id: 5, title: "Journaling & Self-Assessment", description: "Trade logging, pattern recognition, and building your personal edge database." },
  ];

  const experienceLabels: Record<string, string> = {
    beginner: "Beginner",
    intermediate: "Intermediate",
    advanced: "Advanced",
    prop_firm: "Prop firm trader",
  };

  const styleLabels: Record<string, string> = {
    discretionary: "Discretionary",
    "quant-curious": "Quant-curious",
    hybrid: "Hybrid",
    systematic: "Systematic",
  };

  function buildPath(profile: PersonalizationProfile): ModuleInfo[] {
    const result: ModuleInfo[] = modules.map((m) => ({
      ...m,
      badge: "REQUIRED" as const,
      note: "",
    }));

    const hasDailyBiasStruggle = profile.struggles.some((s) => s.toLowerCase().includes("daily bias"));
    const hasMarketStructureStruggle = profile.struggles.some((s) => s.toLowerCase().includes("market structure"));
    const hasBacktestStruggle = profile.struggles.some((s) => s.toLowerCase().includes("backtest"));

    switch (profile.experience) {
      case "beginner":
        // All required, sequential
        result[0].note = "Start here to build a solid structural foundation.";
        result[1].note = "Essential for understanding how institutions move price.";
        result[2].note = "Learn to read the market before each session.";
        result[3].note = "Put it all together with precise trade entries.";
        result[4].note = "Track your progress and find your edge.";
        break;

      case "intermediate":
        // Module 1 review, rest required
        result[0].badge = "REVIEW";
        result[0].note = "You likely know this, but review for gaps in your framework.";
        result[1].note = "Deepen your liquidity read to improve consistency.";
        result[2].note = "A solid daily bias is key to consistent execution.";
        result[3].note = "Refine your entries for higher-probability setups.";
        result[4].note = "Build the feedback loop that creates consistency.";

        if (hasDailyBiasStruggle) {
          result[2].badge = "PRIORITY";
          result[2].note = "You flagged daily bias as a struggle area. This module is your top priority.";
        }
        break;

      case "advanced":
        // Modules 1-2 optional, 3 review, 4-5 required
        result[0].badge = "OPTIONAL";
        result[0].note = "You're past this. Skip unless you want a refresher.";
        result[1].badge = "OPTIONAL";
        result[1].note = "Optional review. You likely have this dialed in.";
        result[2].badge = "REVIEW";
        result[2].note = "Quick review to ensure your bias process is airtight.";
        result[3].note = "Focus area: refine and expand your entry model toolkit.";
        result[4].note = "Systematic journaling to maintain and sharpen your edge.";
        break;

      case "prop_firm":
        // Module 1 review, Module 3 priority, rest required
        result[0].badge = "REVIEW";
        result[0].note = "Quick review to solidify your structural reads under pressure.";
        result[1].note = "Crucial for funded account risk and entry precision.";
        result[2].badge = "PRIORITY";
        result[2].note = "Daily bias is everything for funded accounts. Build a bulletproof process.";
        result[3].note = "Clean entries with tight risk. The prop firm edge.";
        result[4].note = "Track win rates, R-multiples, and drawdown to keep your account.";
        break;
    }

    // Extra emphasis from struggles
    if (hasMarketStructureStruggle && result[0].badge !== "OPTIONAL") {
      result[0].badge = "PRIORITY";
      result[0].note = "You flagged market structure as a struggle. Focus here first.";
    }
    if (hasBacktestStruggle) {
      result[4].badge = "PRIORITY";
      result[4].note = "You want to backtest your ideas. This module gives you the journaling framework to do it.";
    }

    return result;
  }

  const badgeStyles: Record<string, string> = {
    PRIORITY: "bg-amber-500/15 text-amber-400 border-amber-500/25",
    REVIEW: "bg-slate-500/15 text-slate-400 border-slate-500/25",
    OPTIONAL: "bg-slate-600/15 text-slate-500 border-slate-600/25",
    REQUIRED: "bg-brand-500/15 text-brand-300 border-brand-500/25",
  };

  function renderPath(profile: PersonalizationProfile) {
    const pathSubtitle = document.getElementById("path-subtitle")!;
    const pathFocus = document.getElementById("path-focus")!;
    const pathModules = document.getElementById("path-modules")!;

    const instrumentLabels = profile.instruments.map((i) => i.toUpperCase()).join(", ");
    pathSubtitle.textContent = `Based on: ${experienceLabels[profile.experience] || profile.experience} · ${instrumentLabels} · ${styleLabels[profile.style] || profile.style}`;
    pathFocus.textContent = `Focus areas: ${profile.struggles.join(", ")}`;

    const moduleInfos = buildPath(profile);
    pathModules.innerHTML = "";

    moduleInfos.forEach((mod, idx) => {
      const card = document.createElement("div");
      card.className = "border border-white/[0.06] bg-white/[0.02] rounded-xl p-5 transition-all hover:border-white/[0.12]";

      const badgeClass = badgeStyles[mod.badge] || badgeStyles.REQUIRED;

      card.innerHTML = `
        <div class="flex items-start justify-between gap-4 mb-2">
          <div class="flex items-center gap-3">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-sm font-bold text-brand-300">${mod.id}</span>
            <h4 class="text-base font-semibold text-white">${mod.title}</h4>
          </div>
          <span class="flex-shrink-0 text-xs font-medium px-2.5 py-1 rounded-full border ${badgeClass}">${mod.badge}</span>
        </div>
        <p class="text-sm text-slate-500 mb-2 ml-11">${mod.description}</p>
        <p class="text-xs text-slate-400 ml-11 italic">${mod.note}</p>
      `;

      pathModules.appendChild(card);
    });

    // Trigger scroll animation visibility
    const pathRoot = document.getElementById("personalized-path");
    pathRoot?.querySelectorAll(".animate-on-scroll").forEach((el) => {
      el.classList.add("visible");
    });
  }

  // Listen for profile-complete event from ProfileForm
  window.addEventListener("profile-complete", ((e: CustomEvent<PersonalizationProfile>) => {
    renderPath(e.detail);
  }) as EventListener);

  // Also check localStorage on load (returning user)
  document.addEventListener("DOMContentLoaded", () => {
    try {
      const stored = localStorage.getItem("neurospect-course-progress");
      if (stored) {
        const data = JSON.parse(stored);
        if (data.profileCompleted && data.profile) {
          // Hide form, show path
          const formEl = document.getElementById("profile-form");
          if (formEl) formEl.classList.add("hidden");
          const pathEl = document.getElementById("personalized-path");
          if (pathEl) pathEl.classList.remove("hidden");
          renderPath(data.profile);
        }
      }
    } catch {
      // Ignore parse errors
    }
  });
</script>
