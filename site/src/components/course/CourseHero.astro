---

---

<section class="relative overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-brand-950/30 via-black to-black"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[700px] bg-brand-500/[0.07] rounded-full blur-[120px] animate-float-slow"></div>
  <div class="absolute top-20 right-1/4 w-[400px] h-[400px] bg-purple-500/[0.04] rounded-full blur-[100px] animate-float-delayed"></div>

  <!-- Grid background -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 pt-28 pb-24 sm:pt-40 sm:pb-32 text-center">
    <div class="animate-on-scroll inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/[0.08] bg-white/[0.03] text-xs text-slate-400 mb-8 backdrop-blur-sm">
      <span class="relative w-1.5 h-1.5 rounded-full bg-brand-400 pulse-ring"></span>
      Free &bull; 5 Modules &bull; 18 Lessons
    </div>

    <h1 class="animate-on-scroll text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.05] mb-6">
      Master ICT Concepts.<br class="hidden sm:block" />
      <span class="bg-gradient-to-r from-brand-300 via-brand-400 to-cyan-300 bg-clip-text text-transparent">Prove It on the Chart.</span>
    </h1>

    <p class="animate-on-scroll text-lg sm:text-xl text-slate-500 max-w-2xl mx-auto mb-12 leading-relaxed">
      Free 5-module curriculum with interactive assessments, candlestick chart exercises, and personalized learning paths.
    </p>

    <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
      <a
        href="/course/profile"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-white font-semibold text-base transition-all hover:shadow-lg hover:shadow-brand-500/25 hover:-translate-y-0.5 active:translate-y-0"
      >
        Start Course &rarr;
      </a>
      <a
        href="#curriculum"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl border border-white/[0.08] hover:border-white/[0.15] bg-white/[0.02] hover:bg-white/[0.04] text-slate-300 hover:text-white font-medium text-base transition-all"
      >
        View Curriculum
      </a>
    </div>

    <div class="animate-on-scroll inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-amber-500/20 bg-amber-500/[0.05] text-xs text-amber-400/80">
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
      Educational only &mdash; not trading advice
    </div>
  </div>
</section>

<!-- Stats bar -->
<section class="relative border-y border-white/[0.06] bg-white/[0.01]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 stagger-children">
      <div class="animate-on-scroll text-center">
        <div class="text-3xl sm:text-4xl font-bold text-white mb-1">18</div>
        <div class="text-xs text-slate-500 uppercase tracking-wider">Lessons</div>
      </div>
      <div class="animate-on-scroll text-center">
        <div class="text-3xl sm:text-4xl font-bold text-white mb-1">4</div>
        <div class="text-xs text-slate-500 uppercase tracking-wider">Assessment Types</div>
      </div>
      <div class="animate-on-scroll text-center">
        <div class="text-3xl sm:text-4xl font-bold text-white mb-1">7</div>
        <div class="text-xs text-slate-500 uppercase tracking-wider">Entry Models</div>
      </div>
      <div class="animate-on-scroll text-center">
        <div class="text-3xl sm:text-4xl font-bold text-white mb-1 bg-gradient-to-r from-brand-300 to-cyan-300 bg-clip-text text-transparent">Interactive</div>
        <div class="text-xs text-slate-500 uppercase tracking-wider">Charts</div>
      </div>
    </div>
  </div>
</section>
