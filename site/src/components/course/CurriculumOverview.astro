---
import { modules as courseModules } from '../../data/course-modules';

const modules = courseModules.map((mod) => ({
  number: mod.id,
  title: mod.title,
  subtitle: mod.subtitle,
  lessons: mod.lessonCount,
  unlocked: mod.id === 1,
}));
---

<section class="py-24 sm:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-black via-slate-950/50 to-black"></div>
  <div class="absolute top-1/3 right-1/4 w-[500px] h-[500px] bg-brand-500/[0.03] rounded-full blur-[120px]"></div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16 animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Curriculum</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">5 Modules. Structured Progression.</h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto">
        Each module builds on the last. Complete lessons and pass assessments to unlock the next stage.
      </p>
    </div>

    <!-- Module timeline -->
    <div class="relative">
      <!-- Connecting line -->
      <div class="absolute left-6 top-8 bottom-8 w-px border-l border-dashed border-white/10"></div>

      <div class="space-y-4 stagger-children">
        {modules.map((mod) => (
          <div class="animate-on-scroll relative pl-16">
            <!-- Module number circle -->
            <div class={`absolute left-0 top-4 w-12 h-12 rounded-full flex items-center justify-center text-sm font-bold border ${
              mod.unlocked
                ? "border-brand-500/40 bg-brand-500/10 text-brand-400 shadow-lg shadow-brand-500/10"
                : "border-white/[0.08] bg-white/[0.03] text-slate-600"
            }`}>
              {mod.unlocked ? mod.number : (
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                </svg>
              )}
            </div>

            <!-- Module card -->
            <div class={`border rounded-xl p-5 transition-all ${
              mod.unlocked
                ? "border-brand-500/20 bg-brand-500/[0.03] hover:border-brand-500/30"
                : "border-white/[0.06] bg-white/[0.02] hover:border-white/[0.1]"
            }`}>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <span class={`text-xs font-medium uppercase tracking-wider ${mod.unlocked ? "text-brand-400" : "text-slate-600"}`}>
                      Module {mod.number}
                    </span>
                    {mod.unlocked && (
                      <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20">
                        Unlocked
                      </span>
                    )}
                  </div>
                  <h3 class="text-white font-semibold text-lg mb-1">{mod.title}</h3>
                  <p class="text-slate-500 text-sm">{mod.subtitle}</p>
                </div>
                <div class="flex-shrink-0 text-right">
                  <span class={`text-xs ${mod.unlocked ? "text-slate-400" : "text-slate-600"}`}>
                    {mod.lessons} lessons
                  </span>
                </div>
              </div>
            </div>
          </div>
        ))}

        <!-- Entry Models capstone -->
        <div class="animate-on-scroll relative pl-16">
          <!-- Capstone circle -->
          <div class="absolute left-0 top-4 w-12 h-12 rounded-full flex items-center justify-center border border-white/[0.06] bg-white/[0.02]">
            <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
            </svg>
          </div>

          <div class="border border-dashed border-white/[0.08] bg-white/[0.01] rounded-xl p-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-xs font-medium uppercase tracking-wider text-slate-600">Capstone</span>
                </div>
                <h3 class="text-white font-semibold text-lg mb-1">7 ICT Entry Models</h3>
                <p class="text-slate-500 text-sm">Deep-dive into all 7 entry models with interactive chart exercises</p>
              </div>
              <div class="flex-shrink-0">
                <span class="inline-flex items-center gap-1.5 text-xs text-slate-600">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                  </svg>
                  Complete all 5 modules to unlock
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
