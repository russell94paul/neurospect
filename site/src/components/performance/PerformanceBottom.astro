---
const insights = [
  {
    title: "Better filtering matters",
    description: "Tier 4 takes fewer than half the trades of Tier 1 but produces 6x the net PnL. Selectivity, not volume, drives results.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />`,
  },
  {
    title: "Fewer bad trades can outperform more trades",
    description: "Tier 4 avoided 22 bad trades vs. Tier 1's 2. The trades you skip define your edge as much as the ones you take.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />`,
  },
  {
    title: "ICT context improves quant systems",
    description: "Tier 3 outperforms Tier 2 by integrating ICT concepts into quantitative signals, proving that domain knowledge is a quantifiable edge.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />`,
  },
  {
    title: "Quant validation improves discretionary trading",
    description: "Moving from pure discretion (Tier 1) to quant-assisted filtering (Tier 2) cuts mistakes by 67% and nearly triples net PnL.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`,
  },
  {
    title: "NSLM becomes more powerful inside EdgeLab",
    description: "The NeuroSpect Language Model reaches maximum effectiveness when its grading is validated against historical backtests in EdgeLab, creating a continuous feedback loop.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />`,
  },
  {
    title: "Structured review compounds over time",
    description: "Every tier benefits from journaling and review, but the compounding effect is exponential. Tier 4's systematic feedback loop is the single biggest differentiator.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />`,
  },
];
---

<!-- What This Dashboard Proves -->
<section class="py-24 sm:py-32 relative overflow-hidden" id="dashboard-proves">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-black via-slate-950/20 to-black"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-brand-500/[0.04] rounded-full blur-[120px]"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Key Insights</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">What This Dashboard Proves</h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto">
        Six data-driven insights that emerge when you compare discretionary, quant, hybrid, and full-stack trading approaches side by side.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 stagger-children">
      {insights.map((insight) => (
        <div class="animate-on-scroll neon-card rounded-2xl p-5 sm:p-6 group">
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 border border-brand-500/20 flex items-center justify-center mb-4 group-hover:bg-brand-500/15 transition-colors">
            <svg class="w-5 h-5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={insight.icon} />
          </div>
          <h3 class="text-sm font-semibold text-white mb-2 group-hover:text-brand-300 transition-colors">{insight.title}</h3>
          <p class="text-sm text-slate-500 leading-relaxed">{insight.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Find Your Tier CTA -->
<section class="py-24 sm:py-32 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-black via-brand-950/20 to-black"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-brand-500/[0.06] rounded-full blur-[100px]"></div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <div class="animate-on-scroll">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Not sure which tier you are?</h2>
      <p class="text-slate-500 text-lg max-w-xl mx-auto mb-10">
        Join the waitlist and get a personalized trading workflow recommendation based on your current approach, strengths, and growth areas.
      </p>
    </div>

    <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center flex-wrap gap-3">
      <a
        href="#waitlist"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-white font-semibold text-base transition-all hover:shadow-lg hover:shadow-brand-500/25 hover:-translate-y-0.5 active:translate-y-0"
      >
        Join Waitlist
      </a>
      <a
        href="/"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl border border-white/[0.08] hover:border-white/[0.15] bg-white/[0.02] hover:bg-white/[0.04] text-slate-300 hover:text-white font-medium text-base transition-all"
      >
        Explore Features
      </a>
      <a
        href="/pricing"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl border border-white/[0.08] hover:border-white/[0.15] bg-white/[0.02] hover:bg-white/[0.04] text-slate-300 hover:text-white font-medium text-base transition-all"
      >
        See Pricing
      </a>
      <a
        href="/workflows"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl border border-white/[0.08] hover:border-white/[0.15] bg-white/[0.02] hover:bg-white/[0.04] text-slate-300 hover:text-white font-medium text-base transition-all"
      >
        Start Trader Diagnostic
      </a>
    </div>
  </div>
</section>

<!-- Disclaimer -->
<section class="relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 border-t border-white/[0.06]">
    <p class="text-xs text-slate-600 text-center leading-relaxed">
      Illustrative demo data only. This is not financial advice, not live performance, and not a guarantee of future results. Trading involves risk. Past performance, whether real or simulated, does not guarantee future results. All tier comparisons use fabricated data designed to demonstrate platform capabilities.
    </p>
  </div>
</section>
