---

---

<section class="relative overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-brand-950/30 via-black to-black"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[700px] bg-brand-500/[0.07] rounded-full blur-[120px] animate-float-slow"></div>
  <div class="absolute top-20 right-1/4 w-[400px] h-[400px] bg-purple-500/[0.04] rounded-full blur-[100px] animate-float-delayed"></div>

  <!-- Grid background -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 pt-28 pb-24 sm:pt-40 sm:pb-32 text-center">
    <!-- Disclaimer badge -->
    <div class="animate-on-scroll inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-amber-500/20 bg-amber-500/[0.06] text-xs text-amber-400 mb-8 backdrop-blur-sm">
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Illustrative Demo Data &mdash; Not Financial Advice
    </div>

    <h1 class="animate-on-scroll text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.05] mb-6">
      See How Structure Changes<br class="hidden sm:block" />
      <span class="bg-gradient-to-r from-brand-300 via-brand-400 to-cyan-300 bg-clip-text text-transparent">Trader Performance</span>
    </h1>

    <p class="animate-on-scroll text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-8 leading-relaxed">
      An illustrative one-month NQ performance lab comparing discretionary, quant, hybrid, and S-tier trading workflows.
    </p>

    <p class="animate-on-scroll text-base text-slate-500 max-w-xl mx-auto mb-12 leading-relaxed">
      Most traders know ICT concepts but struggle to execute consistently. NeuroSpect helps you move from
      isolated, emotional decisions to evidence-backed workflows &mdash; closing the gap between knowledge and results.
    </p>

    <div class="animate-on-scroll flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="#equity-curve"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-white font-semibold text-base transition-all hover:shadow-lg hover:shadow-brand-500/25 hover:-translate-y-0.5 active:translate-y-0"
      >
        Explore the Data
      </a>
      <a
        href="#kpi-summary"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl border border-white/[0.08] hover:border-white/[0.15] bg-white/[0.02] hover:bg-white/[0.04] text-slate-300 hover:text-white font-medium text-base transition-all"
      >
        View Tier Metrics
      </a>
    </div>
  </div>
</section>
