---
import { TIER_COLORS, TIER_ORDER } from "../../data/tier-colors";
import { IMPROVEMENT_PLANS } from "../../data/tier-kpis";
---

<section class="py-24 sm:py-32 relative overflow-hidden" id="improvement-plans">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-black via-brand-950/15 to-black"></div>
  <div class="absolute top-1/3 left-1/4 w-[600px] h-[500px] bg-emerald-500/[0.03] rounded-full blur-[120px]"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Growth Path</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">How Each Trader Tier Improves with NeuroSpect</h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto">
        Every tier has a clear upgrade path. NeuroSpect meets you where you are and builds systematic strength through targeted modules and structured steps.
      </p>
    </div>

    <div class="space-y-3 stagger-children" id="improvement-accordion">
      {TIER_ORDER.map((id) => {
        const plan = IMPROVEMENT_PLANS[id];
        const tc = TIER_COLORS[id];
        const recTier = TIER_COLORS[plan.recommendedTier as keyof typeof TIER_COLORS];
        return (
          <div class="animate-on-scroll neon-card rounded-2xl overflow-hidden" data-imp-item>
            <!-- Trigger -->
            <button
              class="w-full flex items-center gap-4 p-5 sm:p-6 text-left group"
              data-imp-trigger
            >
              <!-- Color bar -->
              <div class="w-1 self-stretch rounded-full flex-shrink-0" style={`background: ${tc.color};`}></div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-base font-semibold text-white">{tc.name}</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 text-sm">
                  <span class="text-emerald-400/80 truncate">
                    <span class="text-slate-600 mr-1">Strength:</span>{plan.currentStrength.split(".")[0]}
                  </span>
                  <span class="text-red-400/80 truncate hidden sm:inline">
                    <span class="text-slate-600 mr-1">Gap:</span>{plan.currentWeakness.split(".")[0]}
                  </span>
                </div>
              </div>

              <!-- Chevron -->
              <svg
                class="w-5 h-5 text-slate-600 flex-shrink-0 transition-transform duration-300"
                data-imp-chevron
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Panel -->
            <div class="accordion-panel" data-imp-panel>
              <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-0">
                <div class="border-t border-white/[0.06] pt-5 space-y-5">

                  <!-- Strength / Weakness / Missing -->
                  <div class="grid sm:grid-cols-3 gap-4">
                    <div>
                      <h4 class="text-xs font-medium text-emerald-400/60 uppercase tracking-wider mb-2">Current Strength</h4>
                      <p class="text-sm text-slate-400 leading-relaxed">{plan.currentStrength}</p>
                    </div>
                    <div>
                      <h4 class="text-xs font-medium text-red-400/60 uppercase tracking-wider mb-2">Current Weakness</h4>
                      <p class="text-sm text-slate-400 leading-relaxed">{plan.currentWeakness}</p>
                    </div>
                    <div>
                      <h4 class="text-xs font-medium text-amber-400/60 uppercase tracking-wider mb-2">Missing System</h4>
                      <p class="text-sm text-slate-400 leading-relaxed">{plan.missingSystem}</p>
                    </div>
                  </div>

                  <!-- Improvement Steps -->
                  <div>
                    <h4 class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-3">Improvement Steps</h4>
                    <ol class="space-y-2">
                      {plan.steps.map((step, i) => (
                        <li class="flex items-start gap-3">
                          <span class="flex-shrink-0 w-5 h-5 rounded-full bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-[10px] font-mono text-slate-500 mt-0.5">{i + 1}</span>
                          <span class="text-sm text-slate-400 leading-relaxed">{step}</span>
                        </li>
                      ))}
                    </ol>
                  </div>

                  <!-- Recommended Modules -->
                  <div>
                    <h4 class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-3">Recommended Modules</h4>
                    <div class="flex flex-wrap gap-2">
                      {plan.recommendedModules.map((mod) => {
                        const moduleName = mod.split(" — ")[0];
                        const moduleDesc = mod.split(" — ")[1] || "";
                        return (
                          <div class="group/pill relative">
                            <span
                              class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium border border-white/[0.08] bg-white/[0.03] text-slate-300 hover:border-brand-500/30 hover:bg-brand-500/[0.06] transition-all cursor-default"
                            >
                              {moduleName}
                            </span>
                            {moduleDesc && (
                              <span class="hidden group-hover/pill:block absolute bottom-full left-0 mb-2 px-3 py-2 rounded-lg bg-slate-900 border border-white/[0.08] text-xs text-slate-400 whitespace-normal max-w-xs z-10 shadow-xl">
                                {moduleDesc}
                              </span>
                            )}
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  <!-- Upgrade Path + Recommended Tier -->
                  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-3 border-t border-white/[0.06]">
                    <div class="flex-1">
                      <h4 class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-1">Upgrade Path</h4>
                      <p class="text-sm font-semibold text-white">{plan.upgradePath}</p>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs text-slate-500">Target:</span>
                      <span
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border"
                        style={`color: ${recTier.color}; border-color: ${recTier.color}33; background: ${recTier.color}10;`}
                      >
                        <span class="w-2 h-2 rounded-full" style={`background: ${recTier.color};`}></span>
                        {recTier.name}
                      </span>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  function initImprovementAccordion() {
    const container = document.getElementById("improvement-accordion");
    if (!container) return;

    const items = container.querySelectorAll<HTMLElement>("[data-imp-item]");

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>("[data-imp-trigger]");
      const panel = item.querySelector<HTMLElement>("[data-imp-panel]");
      const chevron = item.querySelector<SVGElement>("[data-imp-chevron]");

      if (!trigger || !panel) return;

      trigger.addEventListener("click", () => {
        const isOpen = panel.style.maxHeight && panel.style.maxHeight !== "0px";

        // Close all panels
        items.forEach((other) => {
          const otherPanel = other.querySelector<HTMLElement>("[data-imp-panel]");
          const otherChevron = other.querySelector<SVGElement>("[data-imp-chevron]");
          if (otherPanel) otherPanel.style.maxHeight = "0px";
          if (otherChevron) otherChevron.style.transform = "rotate(0deg)";
        });

        // Toggle the clicked panel
        if (!isOpen) {
          panel.style.maxHeight = panel.scrollHeight + "px";
          if (chevron) chevron.style.transform = "rotate(180deg)";
        }
      });
    });
  }

  initImprovementAccordion();
  document.addEventListener("astro:after-swap", initImprovementAccordion);
</script>
