---
import { TIER_COLORS, TIER_ORDER } from "../../data/tier-colors";
import { MATURITY_DIMENSIONS, MATURITY_SCORES } from "../../data/tier-kpis";

const maturityData = {
  dimensions: [...MATURITY_DIMENSIONS],
  scores: Object.fromEntries(
    TIER_ORDER.map((id) => [id, MATURITY_SCORES[id]])
  ),
  tiers: Object.fromEntries(
    TIER_ORDER.map((id) => [
      id,
      {
        name: TIER_COLORS[id].name,
        short: TIER_COLORS[id].short,
        color: TIER_COLORS[id].color,
        chartColor: TIER_COLORS[id].chartColor,
        chartColorFaded: TIER_COLORS[id].chartColorFaded,
      },
    ])
  ),
};
---

<section class="py-24 sm:py-32 relative overflow-hidden" id="trader-maturity">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-brand-950/20 via-black to-black"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-brand-500/[0.04] rounded-full blur-[120px]"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16 animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Trader Maturity Diagnostic</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Where Each Tier Stands</h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto">
        Nine dimensions of trader maturity &mdash; from ICT concept clarity to feedback loop quality.
        NeuroSpect helps traders build systematic strength across every axis, not just the ones they already know.
      </p>
    </div>

    <div class="animate-on-scroll max-w-3xl mx-auto">
      <div class="neon-card neon-card-cyan rounded-2xl p-5 sm:p-6">
        <div class="chart-container">
          <canvas id="maturity-radar"></canvas>
        </div>

        <!-- Legend -->
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-6 pt-4 border-t border-white/[0.06]">
          {TIER_ORDER.map((id) => (
            <div class="flex items-center gap-2">
              <span
                class="w-3 h-3 rounded-full"
                style={`background: ${TIER_COLORS[id].color};`}
              ></span>
              <span class="text-sm text-slate-400">{TIER_COLORS[id].short}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="maturity-data">
  {JSON.stringify(maturityData)}
</script>

<script>
  function initMaturityRadar() {
    const canvas = document.getElementById("maturity-radar") as HTMLCanvasElement | null;
    if (!canvas) return;

    let initialized = false;

    const observer = new IntersectionObserver(
      async (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && !initialized) {
            initialized = true;
            observer.disconnect();

            const dataEl = document.getElementById("maturity-data");
            if (!dataEl || !dataEl.textContent) return;
            const data = JSON.parse(dataEl.textContent);

            const { Chart, registerables } = await import("chart.js");
            Chart.register(...registerables);

            const tierOrder = ["tier1", "tier2", "tier3", "tier4"];

            new Chart(canvas, {
              type: "radar",
              data: {
                labels: data.dimensions,
                datasets: tierOrder.map((id) => ({
                  label: data.tiers[id].short,
                  data: data.scores[id],
                  borderColor: data.tiers[id].chartColor,
                  backgroundColor: data.tiers[id].chartColorFaded,
                  borderWidth: 2,
                  pointRadius: 3,
                  pointBackgroundColor: data.tiers[id].chartColor,
                  pointBorderColor: data.tiers[id].chartColor,
                  fill: true,
                })),
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                  duration: 1200,
                  easing: "easeOutQuart",
                },
                scales: {
                  r: {
                    min: 0,
                    max: 10,
                    ticks: {
                      stepSize: 2,
                      color: "rgba(148, 163, 184, 0.5)",
                      backdropColor: "transparent",
                      font: { size: 10 },
                    },
                    grid: {
                      color: "rgba(255, 255, 255, 0.1)",
                    },
                    angleLines: {
                      color: "rgba(255, 255, 255, 0.1)",
                    },
                    pointLabels: {
                      color: "rgba(148, 163, 184, 0.8)",
                      font: { size: 11, weight: "500" },
                      padding: 16,
                    },
                  },
                },
                plugins: {
                  legend: {
                    display: false,
                  },
                  tooltip: {
                    backgroundColor: "rgba(15, 15, 20, 0.95)",
                    borderColor: "rgba(255, 255, 255, 0.1)",
                    borderWidth: 1,
                    titleColor: "#fff",
                    bodyColor: "rgba(148, 163, 184, 0.9)",
                    padding: 12,
                    cornerRadius: 8,
                    titleFont: { weight: "600" },
                  },
                },
              },
            });
          }
        }
      },
      { threshold: 0.2 }
    );

    observer.observe(canvas);
  }

  // Run on initial load and on Astro page transitions
  initMaturityRadar();
  document.addEventListener("astro:after-swap", initMaturityRadar);
</script>
