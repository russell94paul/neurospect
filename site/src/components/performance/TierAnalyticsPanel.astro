---
import { TIER_COLORS, TIER_ORDER } from "../../data/tier-colors";
import { TIER_KPIS } from "../../data/tier-kpis";

function fmt(n: number): string {
  const prefix = n >= 0 ? "+$" : "-$";
  return prefix + Math.abs(n).toLocaleString();
}

function pnlColor(n: number): string {
  return n >= 0 ? "text-emerald-400" : "text-red-400";
}

function pct(n: number): string {
  return (n * 100).toFixed(0) + "%";
}

function scoreColor(n: number, max: number = 10): string {
  const ratio = n / max;
  if (ratio >= 0.7) return "text-emerald-400";
  if (ratio >= 0.4) return "text-amber-400";
  return "text-red-400";
}

// For overtrading score, higher is worse (inverted)
function overtradingColor(n: number): string {
  if (n <= 3) return "text-emerald-400";
  if (n <= 6) return "text-amber-400";
  return "text-red-400";
}
---

<section class="py-24 sm:py-32 relative overflow-hidden" id="tier-analytics">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-gradient-to-b from-black via-slate-950/20 to-black"></div>
  <div class="absolute top-1/2 right-1/3 w-[500px] h-[500px] bg-purple-500/[0.03] rounded-full blur-[120px]"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 animate-on-scroll">
      <p class="text-brand-400 text-sm font-medium tracking-wider uppercase mb-3">Detailed Metrics</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Tier-by-Tier Performance</h2>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto">
        Expand each tier for a comprehensive breakdown of core metrics, risk parameters, execution quality, and standout sessions.
      </p>
    </div>

    <div class="space-y-3 stagger-children" id="tier-accordion">
      {TIER_ORDER.map((id) => {
        const kpi = TIER_KPIS[id];
        const tc = TIER_COLORS[id];
        return (
          <div class="animate-on-scroll neon-card rounded-2xl overflow-hidden" data-accordion-item>
            <!-- Trigger -->
            <button
              class="w-full flex items-center gap-4 p-5 sm:p-6 text-left group"
              data-accordion-trigger
            >
              <!-- Color bar -->
              <div class="w-1 self-stretch rounded-full flex-shrink-0" style={`background: ${tc.color};`}></div>

              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-base font-semibold text-white">{kpi.label}: {kpi.name}</span>
                </div>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                  <span class={`font-mono font-semibold ${pnlColor(kpi.netPnl)}`}>{fmt(kpi.netPnl)}</span>
                  <span class="text-slate-500">{pct(kpi.winRate)} WR</span>
                  <span class="text-slate-500">{kpi.totalTrades} trades</span>
                  <span class="text-slate-600 font-mono text-xs">PF {kpi.profitFactor.toFixed(2)}</span>
                </div>
              </div>

              <!-- Chevron -->
              <svg
                class="w-5 h-5 text-slate-600 flex-shrink-0 transition-transform duration-300"
                data-accordion-chevron
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Panel -->
            <div class="accordion-panel" data-accordion-panel>
              <div class="px-5 sm:px-6 pb-5 sm:pb-6 pt-0">
                <div class="border-t border-white/[0.06] pt-5">
                  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">

                    <!-- Core Metrics -->
                    <div>
                      <h4 class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-3">Core</h4>
                      <div class="space-y-2">
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Wins</span>
                          <span class="font-mono text-xs text-emerald-400">{kpi.wins}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Losses</span>
                          <span class="font-mono text-xs text-red-400">{kpi.losses}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Breakevens</span>
                          <span class="font-mono text-xs text-slate-400">{kpi.breakevens}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Profit Factor</span>
                          <span class={`font-mono text-xs ${kpi.profitFactor >= 2 ? "text-emerald-400" : kpi.profitFactor >= 1.5 ? "text-amber-400" : "text-red-400"}`}>{kpi.profitFactor.toFixed(2)}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Expectancy</span>
                          <span class={`font-mono text-xs ${pnlColor(kpi.expectancy)}`}>{fmt(Math.round(kpi.expectancy))}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Avg R</span>
                          <span class={`font-mono text-xs ${kpi.averageR >= 0 ? "text-emerald-400" : "text-red-400"}`}>{kpi.averageR >= 0 ? "+" : ""}{kpi.averageR.toFixed(2)}</span>
                        </div>
                      </div>
                    </div>

                    <!-- Risk Metrics -->
                    <div>
                      <h4 class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-3">Risk</h4>
                      <div class="space-y-2">
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Max Drawdown</span>
                          <span class="font-mono text-xs text-red-400">-${kpi.maxDrawdown.toLocaleString()}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">DD Duration</span>
                          <span class="font-mono text-xs text-slate-300">{kpi.maxDrawdownDuration}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Consec. Losses</span>
                          <span class="font-mono text-xs text-slate-300">{kpi.consecutiveLosses}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Recovery Factor</span>
                          <span class={`font-mono text-xs ${kpi.recoveryFactor >= 3 ? "text-emerald-400" : kpi.recoveryFactor >= 1 ? "text-amber-400" : "text-red-400"}`}>{kpi.recoveryFactor.toFixed(2)}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Sharpe Ratio</span>
                          <span class={`font-mono text-xs ${kpi.sharpeRatio >= 1.5 ? "text-emerald-400" : kpi.sharpeRatio >= 0.8 ? "text-amber-400" : "text-red-400"}`}>{kpi.sharpeRatio.toFixed(2)}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Avg Adverse Excursion</span>
                          <span class="font-mono text-xs text-red-400">-${kpi.averageAdverseExcursion}</span>
                        </div>
                      </div>
                    </div>

                    <!-- Quality Metrics -->
                    <div>
                      <h4 class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-3">Quality</h4>
                      <div class="space-y-2">
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Rule Adherence</span>
                          <span class={`font-mono text-xs ${scoreColor(kpi.ruleAdherence, 1)}`}>{pct(kpi.ruleAdherence)}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Overtrading</span>
                          <span class={`font-mono text-xs ${overtradingColor(kpi.overtradingScore)}`}>{kpi.overtradingScore.toFixed(1)}/10</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Bias Alignment</span>
                          <span class={`font-mono text-xs ${scoreColor(kpi.biasAlignmentScore)}`}>{kpi.biasAlignmentScore.toFixed(1)}/10</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Invalidation Clarity</span>
                          <span class={`font-mono text-xs ${scoreColor(kpi.invalidationClarityScore)}`}>{kpi.invalidationClarityScore.toFixed(1)}/10</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Setup Quality</span>
                          <span class={`font-mono text-xs ${scoreColor(kpi.setupQualityScore)}`}>{kpi.setupQualityScore.toFixed(1)}/10</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Risk Discipline</span>
                          <span class={`font-mono text-xs ${scoreColor(kpi.riskDisciplineScore)}`}>{kpi.riskDisciplineScore.toFixed(1)}/10</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Execution Grade</span>
                          <span class={`font-mono text-xs font-semibold ${
                            kpi.executionGrade.startsWith("A") ? "text-emerald-400" :
                            kpi.executionGrade.startsWith("B") ? "text-amber-400" : "text-red-400"
                          }`}>{kpi.executionGrade}</span>
                        </div>
                      </div>
                    </div>

                    <!-- Favorites -->
                    <div>
                      <h4 class="text-xs font-medium text-slate-600 uppercase tracking-wider mb-3">Highlights</h4>
                      <div class="space-y-2">
                        <div>
                          <span class="text-xs text-slate-500 block">Best Day</span>
                          <span class="font-mono text-xs text-emerald-400">{kpi.bestDay.day} ({fmt(kpi.bestDay.pnl)})</span>
                        </div>
                        <div>
                          <span class="text-xs text-slate-500 block">Worst Day</span>
                          <span class="font-mono text-xs text-red-400">{kpi.worstDay.day} ({fmt(kpi.worstDay.pnl)})</span>
                        </div>
                        <div>
                          <span class="text-xs text-slate-500 block">Best Session</span>
                          <span class="text-xs text-slate-300">{kpi.bestSession}</span>
                        </div>
                        <div>
                          <span class="text-xs text-slate-500 block">Best Setup</span>
                          <span class="text-xs text-slate-300">{kpi.bestSetup}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">A+ Setups</span>
                          <span class="font-mono text-xs text-brand-400">{kpi.aPlusSetups}</span>
                        </div>
                        <div class="flex justify-between">
                          <span class="text-xs text-slate-500">Avoided Bad Trades</span>
                          <span class="font-mono text-xs text-emerald-400">{kpi.avoidedBadTrades}</span>
                        </div>
                      </div>
                    </div>

                  </div>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  function initTierAccordion() {
    const container = document.getElementById("tier-accordion");
    if (!container) return;

    const items = container.querySelectorAll<HTMLElement>("[data-accordion-item]");

    items.forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>("[data-accordion-trigger]");
      const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
      const chevron = item.querySelector<SVGElement>("[data-accordion-chevron]");

      if (!trigger || !panel) return;

      trigger.addEventListener("click", () => {
        const isOpen = panel.style.maxHeight && panel.style.maxHeight !== "0px";

        // Close all panels
        items.forEach((other) => {
          const otherPanel = other.querySelector<HTMLElement>("[data-accordion-panel]");
          const otherChevron = other.querySelector<SVGElement>("[data-accordion-chevron]");
          if (otherPanel) otherPanel.style.maxHeight = "0px";
          if (otherChevron) otherChevron.style.transform = "rotate(0deg)";
        });

        // Toggle the clicked panel
        if (!isOpen) {
          panel.style.maxHeight = panel.scrollHeight + "px";
          if (chevron) chevron.style.transform = "rotate(180deg)";
        }
      });
    });
  }

  initTierAccordion();
  document.addEventListener("astro:after-swap", initTierAccordion);
</script>
